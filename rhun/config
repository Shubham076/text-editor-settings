# rhun configuration. Also editable from Settings (ctrl+,).
# Changes are picked up while rhun is running.

[ui]
follow_system = false
theme = calm
dark_theme = kanagawa
light_theme = rhun-light
scale = 1.1
font_size = 14
font = /Users/shubham.dogra/Library/Fonts/ComicMono.ttf
file_icons = 
sidebar = true
sidebar_width = 240
agents_panel = false
agents_width = 378
panel_full_width = true
tooltips = true
auto_hide_scrollbars = true
decorations = server
scroll_sensitivity = 1.0
fast_scroll_sensitivity = 4.0

[editor]
font_size = 17
font = /Users/shubham.dogra/Library/Fonts/UbuntuSansMono-Medium.ttf
line_height = 1.8
tab_width = 4
insert_spaces = true
line_numbers = true
highlight_line = true
animate_disk_changes = true
match_brackets = true
indent_guides = true
word_wrap = false
whitespace = false
cursor_blink = true
smooth_caret = true
auto_pairs = true
multi_cursor_paste = spread
multi_cursor_modifier = alt
scroll_past_end = true
vim_mode = false
complete_replace = false
complete_commit_characters = true
lightbulb = true
format_on_type = false
format_on_paste = false
folding = true
inline_complete = true
inline_complete_delay = 300
color_swatches = true
highlight_occurrences = true
code_lens = true
inlay_hints = true
semantic_highlighting = true

[files]
trim_trailing_whitespace = false
final_newline = true
format_on_save = false
format_on_save_timeout = 2000
code_actions_on_save = 
code_actions_on_save_timeout = 2000
restore_session = true
restore_project = true
exclude = .git node_modules target build .cache __pycache__ .venv .idea .DS_Store

[agents]
claude = false
codex = true
grok = false
opencode = true
idle_stop_minutes = 10
font_size = 0
ctrl_enter_sends = false
scroll_on_send = true
timestamps = true
focus_view = false
archive_after_days = 14
attach_selection = true
attach_open_file = true
respect_gitignore = true
autosave = true
location = panel
continue_after_restart = true

[claude]
chat = true
executable = 
wrapper = 
initial_mode = 
allow_bypass_permissions = false
prompt_suggestions = true
use_terminal = false
ide = true
disable_login_prompt = false
python_env = true
spinner_verbs = append

[terminal]
shell = 
font_size = 14
font = 
line_height = 1.4
scrollback = 10000
height = 328

[git]
enabled = true
commit_ai = ollama
commit_model = qwen2.5-coder:1.5b

[extensions]
secrets = system

[updates]
check = true
extensions = install

[debug]
show_on_start = true
layout = toolwindow
inline_values = true
inline_values_lines = 50
frames_width = 27
keys_in_terminal = true
console_lines = 10000

[remote]
agent_binary = 

[testing]
gutter = true

[keys]
# ctrl+shift+d = duplicate_line
ctrl+t = select_theme
ctrl+\ = toggle_agents
ctrl+shift+k = agents_insert_mention
alt+d = debug_show
F8 = debug_step_over when inDebugMode
F7 = debug_step_into when inDebugMode
shift+F8 = debug_step_out when inDebugMode
F9 = debug_continue when inDebugMode
ctrl+alt+r = debug_continue when inDebugMode
ctrl+F2 = debug_stop when inDebugMode
ctrl+F8 = debug_toggle_breakpoint
alt+F8 = debug_evaluate when inDebugMode
alt+F9 = debug_run_to_cursor when inDebugMode
ctrl+shift+F8 = debug_view_breakpoints
ctrl+Backspace = delete_line
ctrl+r = replace
ctrl+shift+f = find_in_files
alt+r = rename_file
ctrl+shift+} = next_tab
ctrl+shift+{ = prev_tab
