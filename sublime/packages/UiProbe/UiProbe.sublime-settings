{
	// Tabs are a per-window toggle in Sublime and theme rules for the tab strip only read global
	// preferences, so there is no way to hide the strip for one group. This hides tabs for the
	// whole window while the probe is open (restored on close).
	"hide_tabs": true,

	// Open the probe in a new window instead of splitting the current one. Combined with
	// `hide_tabs` the editor window keeps its tabs and the probe window has none.
	"separate_window": false,

	// Sample lines in the scrollable body.
	"body_lines": 300,
}
