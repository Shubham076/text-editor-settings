[
	// Escape in the debugger panel's prompt strip drops the prompt instead of hiding the panel
	{
		"keys": [
			"escape"
		],
		"command": "debugger_prompt_cancel",
		"context": [
			{
				"key": "setting.debugger.prompt",
				"operator": "equal",
				"operand": true
			},
		]
	},
	// Search what the panel printed (`modules/search.py`): the popup asks for the text and highlights
	// the matches, then primary+g steps up through them and primary+shift+g back down. A terminal
	// is a Terminus view and has the same search from Terminus.
	{
		"keys": ["primary+f"],
		"command": "debugger_search",
		"context": [
			{"key": "debugger.output"},
			{"key": "setting.terminus_view", "operator": "not_equal", "operand": true}
		]
	},
	{
		"keys": ["primary+g"],
		"command": "debugger_search_next",
		"context": [
			{"key": "debugger.output"},
			{"key": "setting.terminus_view", "operator": "not_equal", "operand": true}
		]
	},
	{
		"keys": ["primary+shift+g"],
		"command": "debugger_search_next",
		"args": {"forward": true},
		"context": [
			{"key": "debugger.output"},
			{"key": "setting.terminus_view", "operator": "not_equal", "operand": true}
		]
	},
	// Escape does not close a panel of the debugger that has the focus. Sublime's own escape hides
	// whatever panel is showing, and the popups over a panel (searching it, renaming, inputs) are
	// closed with escape: one press too many and the panel went with them. `always_keep_visible`
	// is about the panel being brought back when something else hides it, not about this key.
	{
		"keys": [
			"escape"
		],
		"command": "noop",
		"context": [
			{
				"key": "debugger.output"
			},
		]
	},
	// Switch to input mode when hitting enter with the console in focus. Not while the completion
	// popup is open: then enter commits the highlighted item, as it does in the editor
	{
		"keys": [
			"enter"
		],
		"command": "debugger",
		"args": {
			"action": "callstack_toggle_input"
		},
		"context": [
			{
				"key": "debugger.output.console",
			},
			{
				"key": "auto_complete_visible",
				"operator": "equal",
				"operand": false
			}
		]
	},
	// Switch to input mode when hitting enter with the callstack in focus (command will switch to console panel)
	{
		"keys": [
			"enter"
		],
		"command": "debugger",
		"args": {
			"action": "callstack_toggle_input"
		},
		"context": [
			{
				"key": "debugger.output.debugger",
			},
			{
				"key": "auto_complete_visible",
				"operator": "equal",
				"operand": false
			}
		]
	},
	// The same from the Breakpoints tab
	{
		"keys": [
			"enter"
		],
		"command": "debugger",
		"args": {
			"action": "callstack_toggle_input"
		},
		"context": [
			{
				"key": "debugger.output.breakpoints",
			},
			{
				"key": "auto_complete_visible",
				"operator": "equal",
				"operand": false
			}
		]
	},
	// Enter on the Watch tab adds the expression typed on its input line (or, with the toolbar
	// above the tabs, moves to its prompt strip). Not while the completion popup is open
	{
		"keys": [
			"enter"
		],
		"command": "debugger",
		"args": {
			"action": "watch_enter"
		},
		"context": [
			{
				"key": "debugger.output.watch",
			},
			{
				"key": "auto_complete_visible",
				"operator": "equal",
				"operand": false
			}
		]
	},
	{
		"keys": [
			"<character>"
		],
		"command": "debugger_memory_input",
		"context": [
			{
				"key": "debugger.view.memory"
			},
		]
	},
]
